# Copy to .env and fill in. Never commit .env.

APP_NAME=Blue Origin API
ENVIRONMENT=development          # development | staging | production | test
DEBUG=false
API_PREFIX=/api
LOG_LEVEL=INFO

# React/Vite dev server origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Data store ------------------------------------------------------------
# dropbox = Dropbox is the database (normal use)
# local   = same layout in backend/app/data/store (offline development only)
DATA_SOURCE=dropbox

# Recommended: long-lived refresh token (see README "Dropbox setup")
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
# Alternative for quick tests only: a short-lived (4 h) access token
DROPBOX_ACCESS_TOKEN=
# Folder that holds the data (inside the app folder for "App folder" apps)
DROPBOX_ROOT=/blue-origin

# Datasets are cached in memory; edits made through the API refresh immediately.
CACHE_TTL_SECONDS=300

# ---- Automatic pipeline ------------------------------------------------------
# Drop Excel/CSV files into <DROPBOX_ROOT>/inbox/<dataset>/ (sales, retailers, distributors,
# benefits, fulfillments, targets) or into inbox/ itself (matched by sheet/file name).
# The backend checks the inbox at startup and every SYNC_INTERVAL_MINUTES (0 = only on demand).
SYNC_INBOX=inbox
SYNC_INTERVAL_MINUTES=1440
# Between those runs the BO_data.ipynb files in /Power BI (FY*_qtr*.csv, a new quarter file too) are checked
# every DATA_WATCH_MINUTES; a change is synced to the dashboard once no file changed for DATA_SETTLE_SECONDS.
DATA_WATCH_MINUTES=2
DATA_SETTLE_SECONDS=120

# BO Dashboard connector: consolidated Power BI files (absolute Dropbox paths). Empty = off.
BO_SOURCE_FOLDER=
BO_TIER_SCHEME=

# ---- BO Retailer Network dashboard
# MAIN DATA: the consolidated distributor sheets, one per quarter (FY25_Qtr3.csv ... FY27_Qtr2.csv).
# The dashboard, sales, tiers and benefits are all built from this folder;
# each sync re-cleans and rebuilds when a file in it changed (no need to run BO_data.ipynb's cleaning part).
BO_DATA_FOLDER=
# Google Sheets download into BO_SHEETS_FOLDER (empty = BO_DATA_FOLDER), run by the sync (empty BO_DISTRIBUTOR_SHEETS = off):
# distributor list csv in Dropbox (Distributor, Sheet URL, Active) and the service-account key (relative = backend/)
BO_DISTRIBUTOR_SHEETS=
BO_GOOGLE_KEY=secrets/bo-data-service-account.json
SHEETS_DOWNLOAD_MINUTES=360
# Reference files only: Dist-state.xlsx, Tier_scheme.xlsx, dedup_overrides.csv. (Without BO_DATA_FOLDER this
# folder's cleaned FY27_qtr2.csv ... and deliverables_consolidated.csv are used instead.)
BO_PIPELINE_INPUT=
# Reference workbook (BO_Consolidate_Final.xlsx) that fills blank retailer city / pincode / phone
BO_INFO_FOLDER=

MAX_UPLOAD_MB=25
VALIDATION_ISSUE_LIMIT=500
PREVIEW_ROWS=20

# ---- Sign-in -----------------------------------------------------------------
# Users are stored in <DROPBOX_ROOT>/meta/users.json and managed on the Users page (admins only).
# AUTH_SECRET signs login tokens (any long random text). Empty = generated once and kept in the store.
AUTH_SECRET=
AUTH_TOKEN_HOURS=12
# First admin account, created only while no users exist yet. Change the password after the first login.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
