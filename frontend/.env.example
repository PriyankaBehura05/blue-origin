# The backend URL is chosen by how the frontend is started; nothing needs switching by hand:
#   npm run dev         .env.development  local frontend -> local backend (http://localhost:8000)
#   npm run dev:remote  .env.remote       local frontend -> deployed backend on Render
#   npm run build       .env.production   deployed site  -> deployed backend on Render
# To override one of them on your machine only, put the values in .env.local (not committed).
# VITE_API_BASE_URL=/api
# VITE_PROXY_TARGET=http://localhost:8000
